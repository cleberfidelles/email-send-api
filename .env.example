# Copie para .env (que está no .gitignore) e preencha.
# O docker-compose lê o .env automaticamente. Para rodar a aplicação,
# exporte as mesmas variáveis (ou configure-as na sua IDE).

# Chave exigida no header X-API-Key (gere algo longo e aleatório: openssl rand -hex 32)
API_KEY=

# Banco (o docker-compose usa DB_PASSWORD como senha do root)
DB_PASSWORD=

# SMTP — no Gmail use uma "Senha de app" (exige verificação em 2 etapas)
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcionais (valores padrão entre parênteses)
# DB_HOST (localhost)  DB_PORT (3306)  DB_NAME (email_send)  DB_USER (root)
# MAIL_HOST (smtp.gmail.com)  MAIL_PORT (587)  KAFKA_SERVERS (localhost:9092)
# DDL_AUTO (update)  SHOW_SQL (false)
